  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>sqldev_adventureworks</DataSourceName>
        <CommandText>SELECT Sales.Fact_SalesOrderDetail.LineTotal, Sales.Dim_Product.ProductName, Sales.Dim_SalesPerson.FullName, Sales.Dim_Product.ProductCategory, Sales.Dim_SalesPerson.CountryRegionCode
FROM  Sales.Fact_SalesOrderDetail INNER JOIN
         Sales.Dim_Product ON Sales.Fact_SalesOrderDetail.ProductKey = Sales.Dim_Product.ProductKey INNER JOIN
         Sales.Dim_SalesPerson ON Sales.Fact_SalesOrderDetail.SalesPersonKey = Sales.Dim_SalesPerson.SalesPersonKey</CommandText>
      </Query>
      <Fields>
        <Field Name="LineTotal">
          <DataField>LineTotal</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="ProductName">
          <DataField>ProductName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="FullName">
          <DataField>FullName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ProductCategory">
          <DataField>ProductCategory</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CountryRegionCode">
          <DataField>CountryRegionCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
