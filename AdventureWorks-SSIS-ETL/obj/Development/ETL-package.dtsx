  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\load data into fact table"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{3C72F19C-D79B-424D-A3F2-ABCB0E82C6FF}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="load data into fact table"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{57EC023B-F6F6-47FD-AF70-2405AD8F6F6E}"
          SQLTask:SqlStatementSource="INSERT INTO AdventureWorksDW_SSIS.Sales.Fact_SalesOrderDetail&#xA;SELECT&#xA;&#x9;SD.SalesOrderDetailID AS SalesOrderDetailKey,&#xA;&#x9;SH.SalesOrderID AS SalesOrderKey,&#xA;&#x9;SD.ProductID AS ProductKey,&#xA;&#x9;SH.CustomerID AS SalesOrderCustomerKey,&#xA;&#x9;ISNULL(SH.SalesPersonID,0) AS SalesPersonKey,&#xA;&#x9;SH.TerritoryID AS TerritoryKey,&#xA;&#x9;CONVERT(INT, CONVERT(VARCHAR(8),SD.ModifiedDate,112)) AS SalesOrderDetailModifiedDateKey,&#xA;&#x9;CONVERT(INT, CONVERT(VARCHAR(8),SH.OrderDate,112)) AS SalesOrderDateKey,&#xA;&#x9;CONVERT(INT, CONVERT(VARCHAR(8),SH.DueDate,112)) AS SalesOrderDueDateKey,&#xA;&#x9;CONVERT(INT, CONVERT(VARCHAR(8),SH.ShipDate,112)) AS SalesOrderShipDateKey,&#xA;&#x9;CONVERT(INT, CONVERT(VARCHAR(8),SH.ModifiedDate,112)) AS SalesOrderModifiedDateKey,&#xA;&#x9;SD.OrderQty,&#xA;&#x9;SD.UnitPrice,&#xA;&#x9;SD.UnitPriceDiscount,&#xA;&#x9;SD.LineTotal,&#xA;&#x9;SH.SubTotal AS SalesOrderSubTotal,&#xA;&#x9;SH.TaxAmt AS SalesOrderTaxAmount,&#xA;&#x9;SH.Freight AS SalesOrderFreightAmount,&#xA;&#x9;SH.TotalDue AS SalesOrderTotalDueAmount&#xA;FROM staging.AdWorksOLTP.SalesOrderDetail SD&#xA;&#x9;LEFT JOIN staging.AdWorksOLTP.SalesOrderHeader SH ON SD.SalesOrderID = SH.SalesOrderID&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\recreate NC indexes"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{23D8A90F-B150-446D-9553-0593114F4736}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="recreate NC indexes"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{57EC023B-F6F6-47FD-AF70-2405AD8F6F6E}"
          SQLTask:SqlStatementSource="CREATE nonclustered index NI_ProductKey ON Sales.Fact_SalesOrderDetail (ProductKey);&#xA;-- CREATE nonclustered index NI_SalesOrderStatusKey ON Sales.Fact_SalesOrderDetail (SalesOrderStatusKey);&#xA;CREATE nonclustered index NI_SalesOrderCustomerKey ON Sales.Fact_SalesOrderDetail (SalesOrderCustomerKey);&#xA;CREATE nonclustered index NI_SalesPersonKey ON Sales.Fact_SalesOrderDetail (SalesPersonKey);&#xA;CREATE nonclustered index NI_TerritoryKey ON Sales.Fact_SalesOrderDetail (TerritoryKey);&#xA;CREATE nonclustered index NI_SalesOrderDetailModifiedDateKey ON Sales.Fact_SalesOrderDetail (SalesOrderDetailModifiedDateKey);&#xA;CREATE nonclustered index NI_SalesOrderDateKey ON Sales.Fact_SalesOrderDetail (SalesOrderDateKey);&#xA;CREATE nonclustered index NI_SalesOrderDueDateKey ON Sales.Fact_SalesOrderDetail (SalesOrderDueDateKey);&#xA;CREATE nonclustered index NI_SalesOrderShipDateKey ON Sales.Fact_SalesOrderDetail (SalesOrderShipDateKey);&#xA;CREATE nonclustered index NI_SalesOrderModifiedDateKey ON Sales.Fact_SalesOrderDetail (SalesOrderModifiedDateKey);&#xA;-- CREATE nonclustered index NI_BillToAddressKey ON Sales.Fact_SalesOrderDetail (BillToAddressKey);&#xA;-- CREATE nonclustered index NI_ShipToAddressKey ON Sales.Fact_SalesOrderDetail (ShipToAddressKey);&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Sequence Container"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:DTSID="{45D6C7F8-5FC9-47A0-BADC-A0117874A77B}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="Sequence Container">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Sequence Container\load data into dim cust"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{4816c78d-a820-4d82-a33d-91de9b19ef4a}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="load data into dim cust"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="1">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{57EC023B-F6F6-47FD-AF70-2405AD8F6F6E}"
              SQLTask:SqlStatementSource="INSERT INTO AdventureWorksDW_SSIS.Sales.Dim_Customer&#xA;SELECT&#xA;&#x9;CustomerID AS CustomerKey,&#xA;&#x9;ISNULL(s.[Name], 'N/A') AS StoreName,&#xA;&#x9;t.[Name] AS Territory,&#xA;&#x9;t.CountryRegionCode,&#xA;&#x9;t.[Group] AS TerritoryGroup,&#xA;-- deal with date cols - see my Confluence page for benefits of having &quot;mini snowflake schema&quot; of dim product joinging to dim date. Code below re-formats date as YYYYMMDD (112 is the format code) and then converts to integer. ChatGPT can explain why this is a good idea.&#xA;ISNULL(CONVERT(INT, CONVERT(VARCHAR(8), s.ModifiedDate, 112)), 99991231) AS ModifiedDateKey&#xA;FROM staging.AdWorksOLTP.Customer c&#xA;LEFT JOIN staging.AdWorksOLTP.Store s ON c.StoreID = s.BusinessEntityID&#xA;LEFT JOIN staging.AdWorksOLTP.SalesTerritory t ON c.TerritoryID = t.TerritoryID&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Sequence Container\load data into dim date"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{f1bacc1a-78db-4272-aabe-bf86aac01911}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="load data into dim date"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="2">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{57EC023B-F6F6-47FD-AF70-2405AD8F6F6E}"
              SQLTask:SqlStatementSource="-- NB I did my development in multiple stages - add some cols, load some data, repeat..... And as a hack I am loading the data in corresponding batches. But it would probably be better to have a single SQL statement that loads all columns.&#xA;&#xA;WITH DateRange AS (&#xA;    SELECT CAST('1980-01-01' AS DATE) AS DateValue&#xA;    UNION ALL&#xA;    SELECT DATEADD(DAY, 1, DateValue)&#xA;    FROM DateRange&#xA;    WHERE DateValue &lt; '2030-12-31'&#xA;),&#xA;-- jay adding default value, using default used in tutorial thruout.&#xA;DateRange_inc_Default AS (&#xA;&#x9;SELECT * From DateRange&#xA;&#x9;UNION ALL&#xA;&#x9;Select CAST('9999-12-31' AS DATE) AS DateValue&#xA;)&#xA;&#xA;INSERT INTO AdventureWorksDW_SSIS.Sales.Dim_Date (DateKey, DateValue)&#xA;SELECT &#xA;    CONVERT(INT, CONVERT(VARCHAR(8), DateValue, 112)) AS DateKey,&#xA;    DateValue&#xA;FROM DateRange_inc_Default&#xA;OPTION (MAXRECURSION 0);&#xA;&#xA;GO&#xA;&#xA;-- from chatgpt - not part of the tutorial but I wanted to play around with this.&#xA;UPDATE AdventureWorksDW_SSIS.Sales.Dim_Date&#xA;SET Year = YEAR([DateValue]),&#xA;    Quarter = CASE &#xA;                WHEN MONTH([DateValue]) IN (1, 2, 3) THEN 1&#xA;                WHEN MONTH([DateValue]) IN (4, 5, 6) THEN 2&#xA;                WHEN MONTH([DateValue]) IN (7, 8, 9) THEN 3&#xA;                ELSE 4&#xA;              END,&#xA;    Month = MONTH([DateValue]),&#xA;    DayOfWeek = DATENAME(WEEKDAY, [DateValue]);&#xA;&#xA;GO&#xA;&#xA;-- from chatgpt - not part of the tutorial but I wanted to play around with this.&#xA;UPDATE AdventureWorksDW_SSIS.Sales.Dim_Date&#xA;SET IsPublicHol = h.is_hol&#xA;FROM AdventureWorksDW_SSIS.Sales.Dim_Date d &#xA;LEFT JOIN staging.python.holidays h ON &#xA;d.DateKey = CONVERT(VARCHAR(8), h.date, 112);&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Sequence Container\load data into dim product"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{66332786-1a72-4419-b5b3-bbf19ed5f894}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="load data into dim product"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="3">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{57EC023B-F6F6-47FD-AF70-2405AD8F6F6E}"
              SQLTask:SqlStatementSource="INSERT INTO AdventureWorksDW_SSIS.Sales.Dim_Product&#xA;SELECT&#xA;P.ProductID AS ProductKey,&#xA;P.[Name] AS ProductName,&#xA;ISNULL(PM.[Name],'N/A') AS ProductModel,&#xA;ISNULL(PC.[Name],'N/A') AS ProductCategory,&#xA;P.ProductNumber AS ProductNumber,&#xA;-- P.MakeFlag,&#xA;-- P.FinishedGoodsFlag,&#xA;ISNULL(P.Color,'N/A') AS Color,&#xA;ISNULL(P.Size,'N/A') AS Size,&#xA;ISNULL(UM_Size.[Name],'N/A') AS SizeUnitMeasure,&#xA;ISNULL(P.[Weight],0) AS [Weight],&#xA;ISNULL(UM_Weight.[Name],'N/A') AS WeightUnitMeasure,&#xA;ISNULL(CAST(P.ProductLine AS NCHAR(3)),'N/A') ProductLine,&#xA;ISNULL(CAST(P.Class AS NCHAR(3)),'N/A') Class,&#xA;ISNULL(CAST(P.Style AS NCHAR(3)),'N/A') Style,&#xA;-- deal with date cols - see my Confluence page for benefits of having &quot;mini snowflake schema&quot; of dim product joinging to dim date. Code below re-formats date as YYYYMMDD (112 is the format code) and then converts to integer. ChatGPT can explain why this is a good idea.&#xA;CONVERT(INT, CONVERT(VARCHAR(8), P.SellStartDate, 112)) AS SellStartDateKey,&#xA;ISNULL(CONVERT(INT, CONVERT(VARCHAR(8), P.SellEndDate, 112)),'99991231') AS SellEndDateKey,&#xA;ISNULL(CONVERT(INT, CONVERT(VARCHAR(8), DiscontinuedDate, 112)),'99991231') AS DiscontinuedDateKey,&#xA;CONVERT(INT, CONVERT(VARCHAR(8), P.ModifiedDate, 112)) AS ModifiedDateKey&#xA;&#xA;FROM staging.AdWorksOLTP.Product P&#xA;LEFT JOIN staging.AdWorksOLTP.ProductSubcategory PSC ON P.ProductSubcategoryID = PSC.ProductSubcategoryID&#xA;LEFT JOIN staging.AdWorksOLTP.ProductCategory PC ON PSC.ProductCategoryID = PC.ProductCategoryID&#xA;LEFT JOIN staging.AdWorksOLTP.ProductModel PM ON P.ProductModelID = PM.ProductModelID&#xA;LEFT JOIN staging.AdWorksOLTP.UnitMeasure UM_Size ON P.SizeUnitMeasureCode = UM_Size.UnitMeasureCode&#xA;LEFT JOIN staging.AdWorksOLTP.UnitMeasure UM_Weight ON P.WeightUnitMeasureCode = UM_Weight.UnitMeasureCode&#xA;GO&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Sequence Container\load data into dim salesperson"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{6ac3b053-4a39-4eea-a2a3-7d77d0502445}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="load data into dim salesperson"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="4">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{57EC023B-F6F6-47FD-AF70-2405AD8F6F6E}"
              SQLTask:SqlStatementSource="INSERT INTO AdventureWorksDW_SSIS.Sales.Dim_SalesPerson&#xA;SELECT&#xA;S.BusinessEntityID AS SalesPersonKey,&#xA;&#x9;FirstName,&#xA;&#x9;ISNULL (MiddleName, 'N/A'),&#xA;&#x9;LastName,&#xA;&#x9;FirstName + ' ' + LastName AS FullName,&#xA;&#x9;ISNULL (t.Name, 'N/A') AS Territory,&#xA;&#x9;ISNULL (t.CountryRegionCode, 'N/A') AS CountryRegionCode,&#xA;&#x9;ISNULL (t.[Group], 'N/A') AS TerritoryGroup,&#xA;-- deal with date cols - see my Confluence page for benefits of having &quot;mini snowflake schema&quot; of dim product joinging to dim date. Code below re-formats date as YYYYMMDD (112 is the format code) and then converts to integer. ChatGPT can explain why this is a good idea.&#xA;CONVERT(INT, CONVERT(VARCHAR(8), s.ModifiedDate, 112)) AS ModifiedDateKey&#xA;FROM staging.AdWorksOLTP.Salesperson s&#xA;LEFT JOIN staging.AdWorksOLTP.Person p ON s.BusinessEntityID = p.BusinessEntityID&#xA;LEFT JOIN staging.AdWorksOLTP.SalesTerritory t ON s.TerritoryID = t.TerritoryID&#xA;GO&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\truncate all Dims"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="truncate target DW tables (*something you would typically only do for staging target tables*)"
