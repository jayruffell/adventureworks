      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{57EC023B-F6F6-47FD-AF70-2405AD8F6F6E}"
          SQLTask:SqlStatementSource="TRUNCATE TABLE [Sales].[Dim_Customer]&#xA;GO&#xA;TRUNCATE TABLE [Sales].[Dim_Product]&#xA;GO&#xA;TRUNCATE TABLE [Sales].[Dim_Salesperson]&#xA;GO&#xA;TRUNCATE TABLE [Sales].[Dim_Date]&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\truncate n drop indexes"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="truncate target DW table (*something you would typically only do for staging target tables*) and drop non-clustered indexes from source table"
      DTS:DTSID="{4752D05A-CAD4-4637-A2AC-7456C5C477B3}"
